# --- Server ---
SECRET_KEY=change-me-in-production
FLASK_ENV=development          # production in deployments
HOST=0.0.0.0
PORT=5000
PUBLIC_BASE_URL=
# Stun the refresh cookie for plain-HTTP development; MUST be true behind TLS.
REFRESH_COOKIE_SECURE=false
# >=1 enables werkzeug ProxyFix (trust X-Forwarded-*) -- keep 0 unless behind a
# fixed reverse proxy, so spoofed X-Forwarded-For cannot bypass rate limits.
TRUSTED_PROXY_COUNT=0
LOG_LEVEL=INFO
# Client request-id header, sanitized before it enters logs.
REQUEST_ID_HEADER=X-Request-Id

# --- Gunicorn (production WSGI server) ---
# gevent is the default worker: each live-tracking SSE stream becomes a greenlet
# instead of occupying a request thread, so a few viewers cannot block the API.
# Uncomment and set GUNICORN_WORKERS to override the default
# min(cpu_count * 2 + 1, 6); leave it unset rather than empty.
GUNICORN_WORKER_CLASS=gevent
# GUNICORN_WORKERS=5
GUNICORN_WORKER_CONNECTIONS=1000
# Long enough for a quiet SSE stream; the endpoint sends heartbeats well inside it.
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30

# --- Auth / JWT ---
# 32+ random chars; rotate and invalidate all sessions when changed.
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=ridemate-api
COOKIE_NAME=rm_refresh
# Enable only after sender-domain verification and successful delivery tests.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFY_TTL_HOURS=24
# Resend transactional email. Keep the API key only in local ignored .env or
# deployment secret settings; never commit a real value.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=RideMate <verify@example.com>

# --- Firebase managed email-link sign-in (optional until configured) ---
# Web values are public client config. The service account JSON is a secret and
# must be set only in Render/local ignored .env, never in tracked files.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Google Sign-In (optional) ---
# Blank => POST /api/auth/google returns 503 google_not_configured. The server
# verifies the `credential` ID token against Google exactly; there is no bypass.
# NEVER put a real client id/secret in this file, in HTML, or in any tracked
# source: the browser fetches the public client id from
# GET /api/auth/providers. Set real values only in the git-ignored backend/.env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MongoDB ---
# Comma-separatedMONGO_URI_FALLBACKS candidates. The app pings each in order
# and uses the first that answers, so cloud Atlas can be primary while a local
# mongod catches you when the network is unavailable.
#
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
#   MONGO_URI_FALLBACKS=mongodb://localhost:27017
#
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ridemate
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000

# --- Rate limiting ---
# Redis is used when REDIS_URL is set; falls back to an in-process counter.
REDIS_URL=
RATE_LIMIT_DEFAULT=120          # requests per minute
RATE_LIMIT_AUTH=12              # login / register / google / password
RATE_LIMIT_STRICT=30            # booking mutations / refresh / payments

# --- CORS ---
# 5000 = Flask-served SPA, 5500/8000 = documented static frontend,
# 5600 = the separate captain-maintenance console (D:\Ridemate-captain-maintenance).
# In production list the exact origins; a wildcard is refused by validate_runtime.
FRONTEND_ORIGINS=http://localhost:5000,http://localhost:5500,http://localhost:8000,http://localhost:5600,http://127.0.0.1:5600
CORS_ALLOW_CREDENTIALS=true

# --- Uploads ---
MAX_UPLOAD_MB=8
# local disk is the default; configure S3 to move uploads to object storage.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=

# --- Payments ---
# PAYMENT_PROVIDER=razorpay (production) or demo (local development only).
# The demo provider settles orders instantly with a synthetic signature and is
# hard-disabled when ENV=production. razorpay requires KEY_ID/KEY_SECRET plus a
# webhook secret (default path /api/payments/webhook).
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_PATH=/api/payments/webhook
# ------------- RAZORPAY -------------
# PLACEHOLDERS ONLY. Never commit a real key id, key secret or webhook secret
# to this file, to HTML, to source, to the README, to a Dockerfile or to a
# release ZIP -- the template ships to clients and ends up in Git history.
# Fetch keys from the Razorpay dashboard and put them in the git-ignored
# backend/.env (TEST keys: https://dashboard.razorpay.com/app/test/key).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signs payment.captured webhooks; from the account's webhook settings.
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX linked account that receives driver payouts.
RAZORPAY_X_ACCOUNT_NUMBER=
PAYOUT_ACCOUNT_ID=
# 'manual' means an admin records the bank reference after paying out of band.
# 'razorpayx' sends the transfer to Razorpay and settles only on their webhook.
PAYOUT_PROVIDER=manual
# Refuses any single payout above this amount rather than silently splitting it.
MAX_PAYOUT_AMOUNT=1000000

# --- Driver KYC ---
# When enabled, a vehicle must be verified before its owner can publish a ride.
# Leave this ON in production: 0 is only for local demo data.
KYC_ENFORCE_PUBLISH=1

# --- Identity KYC (riders and captains) ---
# Identity documents are submitted from the RideMate app (Profile for riders,
# Captain page for drivers) and decided by a human in the RideMate Captain
# Maintenance console. No account can approve itself.
# Captain: approved identity required before publishing.
DRIVER_KYC_ENFORCE_PUBLISH=1
# Rider: approved identity required before booking. Only enable where the review
# queue is staffed (the maintenance console), otherwise every booking is refused.
PASSENGER_KYC_ENFORCE_BOOKING=1

# --- Private document storage ---
# Aadhaar/passport images and RC scans are sealed with AES-256-GCM before they
# touch disk or S3. REQUIRED IN PRODUCTION whenever the identity or vehicle KYC
# gate is enforced (backend/config.py validate_runtime refuses to boot without
# it); non-production falls back to unencrypted storage with a warning.
#
# Exactly 32 bytes, either 64 hex characters or urlsafe-base64. Generate one:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Store it in the secret manager, never in git. Rotating it makes previously
# stored documents unreadable -- there is no re-encryption migration yet.
DOCUMENT_ENCRYPTION_KEY=
# Maximum accepted size for one identity/RC document, in MB.
DOCUMENT_MAX_SIZE_MB=8

# Automated document checks, in front of manual review.
# manual = today's behaviour (human reviews everything, no outbound call).
# mock   = deterministic offline provider for development/tests only.
# signzy = real adapter; credentials/endpoints come ONLY from this environment.
KYC_PROVIDER=manual
# Off by default. When on, a passing automated check verifies the vehicle without
# a human click. A failed or inconclusive check is NEVER auto-rejected.
KYC_AUTO_APPROVE=0
# Opt-in selfie/liveness comparison. Inconclusive when the provider cannot do it.
KYC_FACE_MATCH=0

# Provider credentials. Leave blank for manual/mock.
KYC_PROVIDER_BASE_URL=
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_API_SECRET=
# Required for signzy; also the HMAC secret used to verify POST /api/kyc/webhook.
KYC_PROVIDER_WEBHOOK_SECRET=
# Endpoint paths are configuration because the provider contract is unverified
# in this codebase (see the TODOs in backend/kyc_provider.py).
KYC_PROVIDER_DL_PATH=
KYC_PROVIDER_RC_PATH=
KYC_PROVIDER_INSURANCE_PATH=
KYC_PROVIDER_TIMEOUT_SECONDS=8

# Retry/backoff before an unavailable provider falls back to manual review.
# KYC_MAX_ATTEMPTS is accepted as an alias for older local files.
KYC_PROVIDER_MAX_ATTEMPTS=3
KYC_RETRY_BASE_SECONDS=30
KYC_CLAIM_TTL_SECONDS=300
# How long a finished job and the per-check detail are kept (DPDP retention).
KYC_RETENTION_DAYS=180
# Webhook replay window, in seconds.
KYC_WEBHOOK_MAX_AGE_SECONDS=300
# Version of the consent wording recorded with every consent acceptance.
KYC_CONSENT_TEXT_VERSION=2026-11-01

# --- Booking / platform rules ---
# Commission is exactly 30% of the gross booking amount. The rate AND the rupee
# amount are frozen onto the payment document when the order is created, so a
# later config change can never rewrite a historical settlement.
# MIN_PLATFORM_FEE must stay 0: any non-zero floor makes low-fare bookings
# deviate from the exact 30% invariant and breaks reconciliation.
PLATFORM_FEE_PERCENT=30
MIN_PLATFORM_FEE=0
CANCELLATION_CUTOFF_MINUTES=60
# Unpaid orders (status pending_payment) are expired and their seats released.
PAYMENT_TTL_MINUTES=15
# Realtime location history retention (0 disables the TTL).
LOCATION_HISTORY_TTL_HOURS=168
RIDE_OVERLAP_BUFFER_MINUTES=30
SEATS_MAX_PER_BOOKING=12

# --- External providers (optional) ---
# Leave GOOGLE_MAPS_API_KEY blank to use OpenStreetMap (Nominatim + OSRM), which
# needs no account and is the default.
GOOGLE_MAPS_API_KEY=
OSM_USER_AGENT=ridemate/1.0
OUTBOUND_TIMEOUT_SECONDS=6
# Bias place suggestions to these countries (ISO-3166 alpha-2, comma separated).
# Empty disables the bias; without it a prefix like "Mum" matches places worldwide.
GEO_COUNTRY_CODES=in
# Contact URL/email appended to the Nominatim User-Agent (their usage policy
# expects one). Falls back to PUBLIC_BASE_URL when blank.
GEO_CONTACT_URL=
# In-process cache for type-ahead suggestions (0 disables).
GEO_SEARCH_CACHE_TTL_SECONDS=300
GEO_SEARCH_CACHE_MAX=256

# --- Notifications ---
# Redis pub/sub wakes SSE streams; without Redis the in-process feed still works.
NOTIFY_REDIS_CHANNEL=ridemate:events

# --- Live tracking (SSE) ---
# Each open live-tracking stream holds one gevent greenlet plus a Redis pub/sub
# connection. This caps concurrent streams per worker process so ordinary API
# requests never starve: at the cap the endpoint returns 503 `stream_capacity`
# with `Retry-After: 5`. <=0 disables the cap (not recommended in production).
SSE_MAX_STREAMS=100